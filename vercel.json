{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "https://smart-mine-v2-balanced.onrender.com/admin"
    },
    {
      "source": "/admin.html",
      "destination": "https://smart-mine-v2-balanced.onrender.com/admin.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://smart-mine-v2-balanced.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
